# =============================================================
# Environment Configuration for CCM Manager API
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# Do NOT commit the .env file with real secrets to GitHub.
# =============================================================

# -- Dependency-Track Configuration --
# Base URL of the Dependency-Track instance (SBOM vulnerability analysis tool).
DEPENDENCY_TRACK_URL=http://localhost:8081

# API key for authenticating with the Dependency-Track REST API.
# Generate this from the Dependency-Track admin panel.
API_KEY=your_dependency_track_api_key_here

# -- Network / Allowed IPs --
# Comma-separated list of trusted IP addresses (e.g., cluster nodes or internal services).
IP_LIST=10.0.0.1,10.0.0.2,10.0.0.3

# -- SDT Manager Forwarding --
# URL to forward SBOM/SDT creation requests to the SDTM service.
#FORWARD_URL=http://your-sdtm-host:8005/docs
FORWARD_URL=http://your-sdtm-host:8004/api/SDTM/create

# -- SDT (Software Digital Twin) Service Endpoints --
# URL to trigger deployment of a Software Digital Twin.
DEPLOY_SDT=http://your-sdt-host:8008/deploy

# URL to list existing SDT deployments.
DEPLOYMENTS_SDT=http://your-sdt-host:8008/deployments

# URL to create a new Software Digital Twin.
CREATE_SDT=http://your-sdt-host:8008/create

# URL to delete an existing Software Digital Twin.
DELETE_SDT=http://your-sdt-host:8008/delete

# URL of the local service that sends/distributes an SDT package.
SEND_SDT=http://localhost:5001/send_sdt

# -- MongoDB Configuration --
# MongoDB connection URI used for storing SBOM JSON documents.
SBOM_JSON=mongodb://localhost:27017

# MongoDB connection URI used by the main application.
# Use "mongo" as hostname when running inside Docker Compose; use "localhost" otherwise.
MONGO_URI=mongodb://mongo:27017/

# -- Blockchain / Ledger Endpoints --
# URL to retrieve the full blockchain (supply-chain endpoints) as JSON.
ENDPOINTS=http://your-blockchain-host:3000/chain/json

# URL to retrieve the ledger chain data as JSON.
LEDGER=http://your-ledger-host:3000/chain/json

# URL to retrieve the hash of the latest ledger block (integrity verification).
LEDGER_HASH=http://your-ledger-host:3000/chain/json/hash